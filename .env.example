# =========================
# SERVER
# =========================

PORT=3000

NODE_ENV=development

# =========================
# TELEGRAM
# =========================

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Authentication data older than this will be rejected.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# =========================
# POSTGRESQL
# =========================

DATABASE_URL=postgresql://postgres:password@localhost:5432/memory_coins

# =========================
# FRONTEND
# =========================

FRONTEND_URL=https://your-frontend-domain.com

# =========================
# SESSION
# =========================

SESSION_DAYS=30
